// Khodroyab — Prisma schema (MySQL)
// Phase 1: complete database foundation (11 tables, Section 4 of the spec).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum OptionType {
  text
  number
  select
  checkbox
}

/// Moderation state of a user's sale ad (`user_cars`).
/// Ads created by an administrator are approved automatically; ads created by
/// users from their own panel start as `pending`.
/// Currency of a price: Iranian rial or US dollar.
enum PriceCurrency {
  rial
  usd
}

enum UserCarStatus {
  pending
  approved
  rejected
}

// ─── Table 1: admins ─────────────────────────────────────────────────────────
model Admin {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  name      String   @db.VarChar(255)
  phone     String   @unique @db.VarChar(255)
  email     String?  @db.VarChar(255)
  password  String   @db.VarChar(255)
  /// Root (super) administrator: unrestricted access, including managing
  /// other administrators and roles. Ignores `roleId` entirely.
  isRoot    Boolean  @default(false) @map("is_root")
  /// Inactive administrators cannot sign in and lose any open session.
  isActive  Boolean  @default(true) @map("is_active")
  /// RBAC role for non-root administrators. Null = no section access.
  roleId    BigInt?  @map("role_id") @db.UnsignedBigInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(0)

  role AdminRole? @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@index([roleId])
  @@map("admins")
}

// ─── admin_roles: named permission sets assigned to administrators ──────────
model AdminRole {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  name        String   @unique @db.VarChar(100)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamp(0)

  admins      Admin[]
  permissions AdminRolePermission[]

  @@map("admin_roles")
}

// ─── admin_role_permissions: the panel sections a role may manage ──────────
/// `permission` is one of the keys in `src/lib/auth/permissions.ts`.
model AdminRolePermission {
  roleId     BigInt @map("role_id") @db.UnsignedBigInt
  permission String @db.VarChar(50)

  role AdminRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permission])
  @@map("admin_role_permissions")
}

// ─── Table 2: users ──────────────────────────────────────────────────────────
// NOTE: `name` is BigInt per the source design. See SCHEMA_REVIEW.md.
model User {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name         String    @db.VarChar(255)
  /// Optional business / dealership name (نام مجموعه). When set, other
  /// customers see it instead of `name` on ads, profiles and price lists.
  companyName  String?   @map("company_name") @db.VarChar(255)
  phone        String    @db.VarChar(255)
  email        String?   @db.VarChar(255)
  image        String?   @db.VarChar(255)
  bio          String?   @db.Text
  /// Legacy password hash. Customers sign in with a one-time SMS code (OTP),
  /// so this is null for every account created after the switch.
  password     String?   @db.VarChar(255)
  nationalCode String?   @default("1") @map("national_code") @db.VarChar(255)
  address      String?   @db.VarChar(255)
  postalCode   String?   @map("postal_code") @db.VarChar(255)
  tel          String?   @db.VarChar(255)
  isActive     Boolean   @default(true) @map("is_active")
  /// When the account was approved. Every account (self-registered or created
  /// by the admin) is approved on creation; kept for history.
  approvedAt   DateTime? @map("approved_at") @db.Timestamp(0)
  /// Collaborator (کاربر همکار). Only the admin can turn it on. Collaborators may
  /// publish ads and a price table and see collaborator prices once verified.
  /// NOTE: `collabrate` spelling preserved per spec. See SCHEMA_REVIEW.md.
  collabrate   Boolean   @default(false)
  /// The admin approved the collaborator's identity documents (احراز هویت).
  /// NOTE: `authenticaed` spelling preserved per spec. See SCHEMA_REVIEW.md.
  authenticaed Boolean   @default(false)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamp(0)

  userCars          UserCar[]
  priceTableEntries UserPriceTableEntry[]
  subscriptions     UserSubscription[]
  verification      UserVerification?
  codes             UserCode[]
  buyAds            UserBuyAd[]
  buyAdOffers       UserBuyAdOffer[]

  @@map("users")
}

// ─── Table 3: brands ─────────────────────────────────────────────────────────
model Brand {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  name      String   @db.VarChar(255)
  slug      String   @db.VarChar(255)
  image     String?  @db.VarChar(255)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(0)

  cars Car[]

  @@map("brands")
}

// ─── Table 5: car_types ──────────────────────────────────────────────────────
model CarType {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  name        String   @db.VarChar(255)
  slug        String   @db.VarChar(255)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamp(0)

  cars Car[]

  @@map("car_types")
}

// ─── Table 16: colors ────────────────────────────────────────────────────────
// Colour catalogue managed by the administrator. Used by sale ads and by the
// customers' price tables.
model Color {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  name      String   @unique @db.VarChar(255)
  /// Hex colour code, e.g. "#ffffff".
  code      String   @db.VarChar(7)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(0)

  userCars         UserCar[]
  priceTablePrices UserPriceTablePrice[]
  buyAds           UserBuyAd[]

  @@map("colors")
}

// ─── Table 4: cars ───────────────────────────────────────────────────────────
model Car {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  brandId    BigInt   @map("brand_id") @db.UnsignedBigInt
  carTypeId  BigInt   @map("car_type_id") @db.UnsignedBigInt
  name       String   @db.VarChar(255)
  slug       String   @db.VarChar(255)
  model      String   @db.VarChar(255)
  /// When true, customers may list this car in their personal price table.
  priceTable Boolean  @default(false) @map("price_table")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamp(0)

  brand   Brand   @relation(fields: [brandId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  carType CarType @relation(fields: [carTypeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  userCars          UserCar[]
  carImages         CarImage[]
  buyAds            UserBuyAd[]
  priceTableEntries UserPriceTableEntry[]

  @@index([brandId])
  @@index([carTypeId])
  @@map("cars")
}

// ─── Table 7: car_images ─────────────────────────────────────────────────────
model CarImage {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  carId     BigInt   @map("car_id") @db.UnsignedBigInt
  imageUrl  String   @map("image_url") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(0)

  car Car @relation(fields: [carId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([carId])
  @@map("car_images")
}

// ─── Table 6: options ────────────────────────────────────────────────────────
// Global "car registration form" fields. Every active option is shown on the
// sale-ad form; the values live on the ad (`user_car_options`).
model Option {
  id          BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  name        String     @db.VarChar(255)
  type        OptionType @default(text)
  /// `select` only: whether several items may be chosen at once.
  multiple    Boolean    @default(false)
  isRequired  Boolean    @default(false) @map("is_required")
  /// Inactive options are hidden from the form; existing ad values stay visible.
  isActive    Boolean    @default(true) @map("is_active")
  description String     @db.VarChar(255)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamp(0)

  optionItems OptionItem[]
  userCars    UserCarOption[]

  @@map("options")
}

// ─── Table 7: option_items ───────────────────────────────────────────────────
model OptionItem {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  optionId  BigInt   @map("option_id") @db.UnsignedBigInt
  title     String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(0)

  option   Option          @relation(fields: [optionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  userCars UserCarOption[]

  @@index([optionId])
  @@map("option_items")
}

// ─── Table 9: sale_terms ─────────────────────────────────────────────────────
model SaleTerm {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  title       String   @db.VarChar(255)
  description String?  @db.VarChar(255)
  image       String?  @db.VarChar(255)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamp(0)

  userCarSaleTerms UserCarSaleTerm[]

  @@map("sale_terms")
}

// ─── Table 10: user_cars ─────────────────────────────────────────────────────
// NOTE: `qautity` spelling preserved per spec. See SCHEMA_REVIEW.md.
model UserCar {
  id          BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  userId      BigInt        @map("user_id") @db.UnsignedBigInt
  carId       BigInt        @map("car_id") @db.UnsignedBigInt
  /// Public, unique 6-digit ad code generated by the system on creation.
  code        String        @unique @db.VarChar(6)
  status      UserCarStatus @default(pending)
  qautity     String        @db.VarChar(255)
  description String        @db.VarChar(255)
  /// Production year of this listing, 4 ASCII digits (Gregorian or Jalali).
  year        String        @db.VarChar(10)
  /// Mileage (کارکرد) in kilometres. Required by the form; 0 = brand new.
  mileage     Int           @default(0) @db.UnsignedInt
  /// Currency of every price on this ad (sale-term prices, discounts, price history).
  currency    PriceCurrency @default(rial)
  /// Colour from the `colors` catalogue. Required by the form; null only on legacy ads.
  colorId     BigInt?       @map("color_id") @db.UnsignedBigInt
  isActive    Boolean       @default(true) @map("is_active")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamp(0)

  user  User   @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  car   Car    @relation(fields: [carId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  color Color? @relation(fields: [colorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  saleTerms UserCarSaleTerm[]
  images    UserCarImage[]
  options   UserCarOption[]

  @@index([userId])
  @@index([carId])
  @@index([colorId])
  @@index([year])
  @@index([status])
  @@map("user_cars")
}

// ─── Table 19: user_car_images ───────────────────────────────────────────────
// Photos uploaded for one ad. Exactly one row is primary when any exist.
model UserCarImage {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  userCarId BigInt   @map("user_car_id") @db.UnsignedBigInt
  imageUrl  String   @map("image_url") @db.VarChar(255)
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(0)

  userCar UserCar @relation(fields: [userCarId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userCarId])
  @@map("user_car_images")
}

// ─── Table 20: user_car_options ──────────────────────────────────────────────
// Values an ad holds for the global options. `select` options store one row per
// chosen item (`option_item_id`); text, number and checked checkbox store `val`.
// An unchecked checkbox or an empty field has no row.
model UserCarOption {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  userCarId    BigInt   @map("user_car_id") @db.UnsignedBigInt
  optionId     BigInt   @map("option_id") @db.UnsignedBigInt
  optionItemId BigInt?  @map("option_item_id") @db.UnsignedBigInt
  val          String?  @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamp(0)

  userCar    UserCar     @relation(fields: [userCarId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  option     Option      @relation(fields: [optionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  optionItem OptionItem? @relation(fields: [optionItemId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userCarId])
  @@index([optionId])
  @@index([optionItemId])
  @@map("user_car_options")
}

// ─── Table 11: user_car_sale_terms ───────────────────────────────────────────
// NOTE: `perecentage` spelling preserved per spec. See SCHEMA_REVIEW.md.
model UserCarSaleTerm {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  userCarId    BigInt   @map("user_car_id") @db.UnsignedBigInt
  saleTermId   BigInt   @map("sale_term_id") @db.UnsignedBigInt
  /// Public price (قیمت عمومی), shown to every customer. Its changes are logged in the price history.
  price        String   @db.VarChar(255)
  /// Collaborator price (قیمت همکار), shown only to verified collaborators.
  /// Required by the form; null only on ads created before collaborator prices existed.
  partnerPrice String?  @map("partner_price") @db.VarChar(255)
  sale         String?  @db.VarChar(255)
  perecentage  String?  @db.VarChar(255)
  description  String?  @db.Text
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamp(0)

  userCar  UserCar  @relation(fields: [userCarId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  saleTerm SaleTerm @relation(fields: [saleTermId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  priceHistory UserCarSaleTermPriceHistory[]

  @@index([userCarId])
  @@index([saleTermId])
  @@map("user_car_sale_terms")
}

/// Who changed a sale-term price.
enum PriceChangeSource {
  user
  admin
  system
}

// ─── Table 12: user_car_sale_term_price_histories ────────────────────────────
// Append-only log of every price a sale term has had. The first row is written
// when the term is created; a new row is appended whenever the price changes.
// The latest two rows give the "current vs previous" delta shown in search.
model UserCarSaleTermPriceHistory {
  id                BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  userCarSaleTermId BigInt            @map("user_car_sale_term_id") @db.UnsignedBigInt
  /// Price at this point in time (digit-only string, same format as `user_car_sale_terms.price`).
  price             String            @db.VarChar(255)
  source            PriceChangeSource @default(user)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamp(0)

  userCarSaleTerm UserCarSaleTerm @relation(fields: [userCarSaleTermId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userCarSaleTermId, createdAt])
  @@map("user_car_sale_term_price_histories")
}

// ─── Table 13: user_price_table_entries ──────────────────────────────────────
// A customer's personal price table: one row per (user, car). Only cars with
// `cars.price_table = true` may appear here; the admin controls that flag.
// The prices themselves live in `user_price_table_prices`, one row per
// (production year, colour) combination the customer chose to price.
model UserPriceTableEntry {
  id        BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  userId    BigInt        @map("user_id") @db.UnsignedBigInt
  carId     BigInt        @map("car_id") @db.UnsignedBigInt
  /// Currency of every price of this row (all its year/colour tiers).
  currency  PriceCurrency @default(usd)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamp(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  car  Car  @relation(fields: [carId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  prices UserPriceTablePrice[]

  @@unique([userId, carId])
  @@index([carId])
  @@map("user_price_table_entries")
}

// ─── Table 17: user_price_table_prices ───────────────────────────────────────
// One price tier of a price-table row: the raw / clearance / instant USD
// prices for a production year typed by the customer and a colour from the
// `colors` catalogue. The year is the customer's own and is independent of
// the year of any sale ad. A (year, colour) pair is unique within a row, so the same year
// may appear with different colours. Only tiers with at least one price are stored.
model UserPriceTablePrice {
  id                    BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  entryId               BigInt   @map("entry_id") @db.UnsignedBigInt
  /// Production year, 4 ASCII digits (Gregorian or Jalali), e.g. "2025".
  year                  String   @db.VarChar(10)
  /// Colour of this tier, picked from the `colors` catalogue.
  colorId               BigInt   @map("color_id") @db.UnsignedBigInt
  /// Raw price (قیمت خام) in US dollars (digit-only string, same convention as sale-term prices).
  priceUsd              String?  @map("price_usd") @db.VarChar(255)
  /// Clearance price (قیمت ترخیصی) in US dollars, digit-only string.
  clearancePrice        String?  @map("clearance_price") @db.VarChar(255)
  /// Instant price (قیمت فوری) in US dollars, digit-only string.
  instantPrice          String?  @map("instant_price") @db.VarChar(255)
  /// Collaborator versions of the three prices above, shown only to verified collaborators.
  partnerPriceUsd       String?  @map("partner_price_usd") @db.VarChar(255)
  partnerClearancePrice String?  @map("partner_clearance_price") @db.VarChar(255)
  partnerInstantPrice   String?  @map("partner_instant_price") @db.VarChar(255)
  /// Display order inside the row (the customer's order, 0-based).
  sortOrder             Int      @default(0) @map("sort_order") @db.UnsignedInt
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamp(0)

  entry UserPriceTableEntry @relation(fields: [entryId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  color Color               @relation(fields: [colorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([entryId, year, colorId])
  @@index([colorId])
  @@map("user_price_table_prices")
}

// ─── Table 14: subscription_plans ────────────────────────────────────────────
// Plans the administrator can grant to customers. A plan's duration is in
// months; every month counts as 30 days of panel access.
model SubscriptionPlan {
  id             BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  name           String   @db.VarChar(255)
  durationMonths Int      @map("duration_months") @db.UnsignedInt
  /// Digit-only string (Toman), same convention as sale-term prices.
  price          String   @db.VarChar(255)
  description    String?  @db.Text
  /// Inactive plans stay in history but can no longer be granted.
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamp(0)

  userSubscriptions UserSubscription[]

  @@map("subscription_plans")
}

/// Lifecycle of one granted subscription.
/// - `active`: the user's current subscription (access until `ends_at`).
/// - `renewed`: superseded by a newer grant that absorbed its remaining days.
/// - `cancelled`: revoked by an administrator before it ran out.
enum UserSubscriptionStatus {
  active
  renewed
  cancelled
}

// ─── Table 15: user_subscriptions ────────────────────────────────────────────
// Append-only history of every subscription granted to a user. Plan fields are
// snapshotted so later edits to a plan never rewrite the user's history.
model UserSubscription {
  id             BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  userId         BigInt                 @map("user_id") @db.UnsignedBigInt
  planId         BigInt                 @map("plan_id") @db.UnsignedBigInt
  planName       String                 @map("plan_name") @db.VarChar(255)
  durationMonths Int                    @map("duration_months") @db.UnsignedInt
  price          String                 @db.VarChar(255)
  /// Days granted by this plan (duration_months × 30).
  addedDays      Int                    @map("added_days") @db.UnsignedInt
  /// Remaining days carried over from the previous active subscription.
  carriedDays    Int                    @default(0) @map("carried_days") @db.UnsignedInt
  /// Free-text note entered by the administrator.
  description    String?                @db.Text
  status         UserSubscriptionStatus @default(active)
  startsAt       DateTime               @map("starts_at") @db.Timestamp(0)
  endsAt         DateTime               @map("ends_at") @db.Timestamp(0)
  cancelledAt    DateTime?              @map("cancelled_at") @db.Timestamp(0)
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt      DateTime               @updatedAt @map("updated_at") @db.Timestamp(0)

  user User             @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  plan SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId, status, endsAt])
  @@index([planId])
  @@map("user_subscriptions")
}

// ─── Table 18: sponsors ──────────────────────────────────────────────────────
// Sponsors managed by the administrator. Active ones are shown, ordered by
// `sort_order` (ascending), in the logo strip of the customer login page.
model Sponsor {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  name      String   @db.VarChar(255)
  /// Logo path (`/uploads/sponsors/...`) or absolute URL.
  logo      String   @db.VarChar(1024)
  isActive  Boolean  @default(true) @map("is_active")
  /// Display priority: lower numbers are shown first.
  sortOrder Int      @default(0) @map("sort_order") @db.UnsignedInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(0)

  @@index([isActive, sortOrder])
  @@map("sponsors")
}

/// Legal form of a collaborator: natural person (حقیقی) or legal entity (حقوقی).
enum VerificationPersonType {
  natural
  legal
}

/// Review state of a collaborator's identity documents.
enum UserVerificationStatus {
  pending
  approved
  rejected
}

// ─── Table 21: user_verifications ────────────────────────────────────────────
// A collaborator's latest identity-verification submission (one per user).
// A new submission after a rejection replaces the previous one and its documents.
// The outcome is mirrored on `users.authenticaed`.
model UserVerification {
  id                BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  userId            BigInt                 @unique @map("user_id") @db.UnsignedBigInt
  personType        VerificationPersonType @map("person_type")
  /// Natural: business-license owner's full name. Legal: CEO's full name.
  fullName          String?                @map("full_name") @db.VarChar(120)
  /// Natural: business-license owner's national code. Legal: CEO's national code.
  nationalCode      String?                @map("national_code") @db.VarChar(10)
  /// Legal only: company / organization name.
  companyName       String?                @map("company_name") @db.VarChar(255)
  /// Legal only: company national ID (شناسه ملی, 11 digits).
  companyNationalId String?                @map("company_national_id") @db.VarChar(11)
  status            UserVerificationStatus @default(pending)
  /// Reason written by the admin when rejecting; shown to the user.
  rejectReason      String?                @map("reject_reason") @db.Text
  reviewedAt        DateTime?              @map("reviewed_at") @db.Timestamp(0)
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt         DateTime               @updatedAt @map("updated_at") @db.Timestamp(0)

  user      User                       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  documents UserVerificationDocument[]

  @@index([status])
  @@map("user_verifications")
}

// ─── Table 22: user_verification_documents ───────────────────────────────────
// One identity document (title + image) of a verification submission. Images are
// private: stored outside the public uploads and served only to the admin and owner.
model UserVerificationDocument {
  id             BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  verificationId BigInt   @map("verification_id") @db.UnsignedBigInt
  title          String   @db.VarChar(255)
  /// File name inside the private verification storage.
  imageUrl       String   @map("image_url") @db.VarChar(255)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamp(0)

  verification UserVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([verificationId])
  @@map("user_verification_documents")
}

// ─── Table 23: user_codes ────────────────────────────────────────────────────
// Public, rotating 8-digit code of a user. Other customers see this code on the
// user's ads and price-list rows instead of the name, phone or photo. A code is
// valid until `expires_at`; a new one is generated lazily the next time the
// user's code is needed after that. Rows are never deleted, so the admin can
// find a user by any code they ever had. Codes are unique across all history.
model UserCode {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  userId    BigInt   @map("user_id") @db.UnsignedBigInt
  /// 8 ASCII digits, first digit non-zero.
  code      String   @unique @db.Char(8)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  expiresAt DateTime @map("expires_at") @db.Timestamp(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, expiresAt])
  @@map("user_codes")
}

// ─── Table 24: system_settings ───────────────────────────────────────────────
// Key/value settings edited by the root administrator (تنظیمات سیستم).
// Keys and defaults live in `src/lib/system-settings-shared.ts`.
model SystemSetting {
  key       String   @id @db.VarChar(100)
  value     String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(0)

  @@map("system_settings")
}

// ─── Table 25: user_otps ─────────────────────────────────────────────────────
// One-time sign-in codes sent by SMS to a mobile number. Only the hash of the
// code is stored. A code expires at `expires_at`, is locked after too many
// wrong guesses and is single-use (`consumed_at`).
model UserOtp {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  phone      String    @db.VarChar(20)
  codeHash   String    @map("code_hash") @db.VarChar(64)
  attempts   Int       @default(0) @db.UnsignedInt
  expiresAt  DateTime  @map("expires_at") @db.Timestamp(0)
  consumedAt DateTime? @map("consumed_at") @db.Timestamp(0)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamp(0)

  @@index([phone, createdAt])
  @@map("user_otps")
}

// ─── Table 26: provinces ─────────────────────────────────────────────────────
// Iran's provinces. Ids come from the source data (`data/provinces.sql`), so
// they are kept stable by the seeder (`prisma/seed-locations.mjs`).
model Province {
  id   Int    @id @default(autoincrement()) @db.UnsignedInt
  name String @db.VarChar(100)

  cities   City[]
  branches Branch[]

  @@map("provinces")
}

// ─── Table 27: cities ────────────────────────────────────────────────────────
// Cities of each province (`data/cities.sql`).
model City {
  id         Int    @id @default(autoincrement()) @db.UnsignedInt
  provinceId Int    @map("province_id") @db.UnsignedInt
  name       String @db.VarChar(100)

  province Province @relation(fields: [provinceId], references: [id], onDelete: Restrict)
  branches Branch[]

  @@index([provinceId])
  @@map("cities")
}

// ─── Table 28: branches ──────────────────────────────────────────────────────
// Khodroyab branches, managed in the admin panel and listed on the customer
// panel's Contact page. The city must belong to the province (checked on save).
model Branch {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  provinceId  Int      @map("province_id") @db.UnsignedInt
  cityId      Int      @map("city_id") @db.UnsignedInt
  title       String   @db.VarChar(150)
  managerName String   @map("manager_name") @db.VarChar(120)
  phone       String   @db.VarChar(20)
  /// Optional street address shown under the branch.
  address     String?  @db.VarChar(500)
  latitude    Decimal  @db.Decimal(9, 6)
  longitude   Decimal  @db.Decimal(9, 6)
  isActive    Boolean  @default(true) @map("is_active")
  /// Display priority: lower numbers are shown first.
  sortOrder   Int      @default(0) @map("sort_order") @db.UnsignedInt
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamp(0)

  province Province @relation(fields: [provinceId], references: [id], onDelete: Restrict)
  city     City     @relation(fields: [cityId], references: [id], onDelete: Restrict)

  @@index([provinceId])
  @@index([cityId])
  @@index([isActive, sortOrder])
  @@map("branches")
}

// ─── Table 29: user_buy_ads ──────────────────────────────────────────────────
// Buy ads (آگهی خرید): a collaborator asks for a car with a given year, colour
// and mileage. No prices and no moderation: an ad is public as soon as it is
// saved, until its owner deactivates or deletes it. Other customers only ever
// see the owner's rotating public code.
model UserBuyAd {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  userId      BigInt   @map("user_id") @db.UnsignedBigInt
  carId       BigInt   @map("car_id") @db.UnsignedBigInt
  /// Public, unique 6-digit code generated by the system on creation.
  code        String   @unique @db.VarChar(6)
  /// Requested production year, 4 ASCII digits (Gregorian or Jalali).
  year        String   @db.VarChar(10)
  /// Requested mileage (کارکرد) in kilometres; 0 = brand new.
  mileage     Int      @default(0) @db.UnsignedInt
  colorId     BigInt   @map("color_id") @db.UnsignedBigInt
  /// Optional free-text notes from the buyer.
  description String?  @db.VarChar(1000)
  /// The owner can pause an ad (e.g. once the car is found) without deleting it.
  isActive    Boolean  @default(true) @map("is_active")
  /// Currency of every price offer on this ad. Locked once an offer exists.
  currency    PriceCurrency @default(rial)
  /// Collaborators may send price offers while true. The owner closes and
  /// reopens bidding; existing offers are kept either way.
  biddingOpen Boolean  @default(true) @map("bidding_open")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamp(0)

  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  car    Car              @relation(fields: [carId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  color  Color            @relation(fields: [colorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  offers UserBuyAdOffer[]

  @@index([userId])
  @@index([carId])
  @@index([colorId])
  @@index([year])
  @@index([isActive, createdAt])
  @@map("user_buy_ads")
}

// ─── Table 30: user_buy_ad_offers ────────────────────────────────────────────
// Price offers (پیشنهاد قیمت) of verified collaborators on a buy ad, in the
// ad's currency. One row per bidder: editing an offer updates that row.
model UserBuyAdOffer {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  buyAdId   BigInt   @map("buy_ad_id") @db.UnsignedBigInt
  userId    BigInt   @map("user_id") @db.UnsignedBigInt
  /// Offered price, a whole number in the ad's currency.
  price     BigInt   @db.UnsignedBigInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(0)

  buyAd UserBuyAd @relation(fields: [buyAdId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([buyAdId, userId])
  @@index([buyAdId, price])
  @@index([userId])
  @@map("user_buy_ad_offers")
}
