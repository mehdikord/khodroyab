# ─── Database ────────────────────────────────────────────────────────────────
# MySQL connection string. In production, use a dedicated least-privilege user
# instead of root. Example:
#   mysql://<user>:<password>@<host>:3306/<database>
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/khodroyab"

# ─── Authentication ──────────────────────────────────────────────────────────
# Cryptographically secure secret used to sign administrator session tokens.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="replace-with-a-long-random-secret"

# Session lifetime in seconds (default: 8 hours).
AUTH_SESSION_TTL_SECONDS="28800"

# ─── Seeder safety ───────────────────────────────────────────────────────────
# Must be "production" in production so the development administrator is not
# created. Leave empty / "development" locally.
NODE_ENV="development"
